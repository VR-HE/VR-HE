# Ignore rules for this Unity prototype only. Leading slashes anchor each rule to this
# folder: the repository-root rules are anchored to the repository root and do not reach here.
# Unanchored root rules (*.csproj, *.slnx, *.log, .vs/, *.apk and similar) still apply.

# Unity-generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ExportedObj/

# Generated editor, IDE and package-tool files
/.vscode/
/.idea/
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*
/ServerData/
/UIElementsSchema/

# Synthetic fixtures are regenerated by Tools/generate_synthetic_splats.py.
/Fixtures/Generated/

# Raw benchmark output (full screenshots, per-frame samples, browser logs and temporary
# profiles). Curated summaries and small screenshots live in TestResults/ and are tracked.
/TestResults/raw/

# Windows test bundles, their staging folders and downloaded runtime caches
# (Tools/package_toughbook_bundle.py). Only source, scripts and docs are tracked.
/Bundles/

# Python bytecode caches (the tools set sys.dont_write_bytecode; this is a safety net)
/Tools/__pycache__/
